# Example configuration for the phantun kernel module.
#
# Disabled by default: uncomment and adjust 'global' below, then run
# `/etc/init.d/phantun enable && /etc/init.d/phantun restart`.
#
# At least one of managed_local_ports or managed_remote_peers is required
# once the section is enabled. See README.md for the full parameter list.

#config global 'global'
#	option enabled '1'
#	list managed_local_ports '51820'
#	list managed_remote_peers '198.51.100.20:51820'
#	option reserved_local_ports 'off'
#	option ip_families 'both'
#	option managed_netns 'init'
#	option handshake_request ''
#	option handshake_response ''
#	option handshake_timeout_ms ''
#	option handshake_retries ''
#	option keepalive_interval_sec ''
#	option keepalive_misses ''
#	option hard_idle_timeout_sec ''
#	option reopen_guard_bytes ''
#	option half_open_limit ''
#	option replacement_quarantine_ms ''
#	option replacement_protect_ms ''
#	list raw_kernel_parameters ''
